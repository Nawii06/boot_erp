# Fake examples only. Runtime uses the restricted app account, never the owner.
DATABASE_URL=postgresql://boot_erp_dev_app:FAKE_PASSWORD@127.0.0.1:55432/boot_erp_dev
# Supply only to the migration process; do not set in the web process.
MIGRATION_DATABASE_URL=postgresql://boot_erp_dev_owner:FAKE_PASSWORD@127.0.0.1:55432/boot_erp_dev
TEST_DATABASE_URL=postgresql://boot_erp_test_app:FAKE_PASSWORD@127.0.0.1:55432/boot_erp_test
TEST_MIGRATION_DATABASE_URL=postgresql://boot_erp_test_owner:FAKE_PASSWORD@127.0.0.1:55432/boot_erp_test
# Optional future storage adapter. Current private evidence is stored as DB bytea;
# authenticated API downloads only. Do not expose this directory as public uploads.
PRIVATE_STORAGE_ROOT=C:/boot_erp_private/files
# Local helper only. Use a private file outside this repository; this path is fictitious.
# Set in the shell before scripts/app.cmd run local -- dev (the helper does not load .env).
BOOT_ERP_GOOGLE_OAUTH_FILE=C:/boot_erp_private/google-oauth.example.json
# The helper supplies GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI /
# APP_ORIGIN and private AUTH_ENCRYPTION_KEY only to dev/start. See docs/phase-02-guide.md.
# Bootstrap/recovery helper only; fictitious private file path.
BOOT_ERP_ADMIN_FILE=C:/boot_erp_private/admin.example.json
# Optional local-tool roots; never point them inside the repository.
# BOOT_ERP_LOCAL_ROOT=C:/boot_erp_private
# BOOT_ERP_BACKUP_ROOT=C:/boot_erp_private/backups
# BOOT_ERP_PG_BIN=C:/approved-postgresql/bin
# Deployment target remains undecided. For a future HTTPS web process supply:
# APP_ORIGIN=https://erp.example.invalid
# GOOGLE_CLIENT_ID=FAKE_CLIENT.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=FAKE_SECRET_DO_NOT_USE
# GOOGLE_REDIRECT_URI=https://erp.example.invalid/api/auth/google/callback
# AUTH_ENCRYPTION_KEY=<original 64-hex private key; never replace on existing DB>
# Supply only the restricted runtime DATABASE_URL; omit all owner/migration/test URLs.
# Local helpers intentionally support localhost only; see docs/operations-runbook.md.
